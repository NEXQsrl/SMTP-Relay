{
  "SmtpRelay": {
    "ServiceName": "SmtpRelay",
    "DataDirectory": "C:\\ProgramData\\SmtpRelay",

    "Listener": {
      "IpAddress": "0.0.0.0",
      "Port": 25,
      "ServerName": "smtp-relay",
      "MaxMessageSizeBytes": 26214400,
      "MaxRecipients": 100,
      "CommandTimeoutSeconds": 120,
      "MaxConcurrentSessions": 50
    },

    "Tls": {
      "Mode": "None",
      "CertificatePath": "",
      "CertificatePasswordSecret": "TlsCertPassword",
      "CertificateThumbprint": "",
      "MinimumProtocol": "Tls12"
    },

    "Security": {
      "AllowedIps": [
        "127.0.0.1",
        "::1"
      ],
      "RejectWhenAllowListEmpty": true,
      "Authentication": {
        "Mode": "Disabled",
        "AllowFromAnyAddress": false,
        "AllowWithoutTls": false
      }
    },

    "Upstream": {
      "Mode": "Microsoft365",
      "Host": "smtp.office365.com",
      "Port": 587,
      "Security": "StartTls",
      "AllowInsecureAuthentication": false,
      "TimeoutSeconds": 100,
      "MaxAttempts": 3,
      "RetryBaseDelaySeconds": 5,
      "OverrideFromAddress": "",
      "Basic": {
        "Username": "",
        "PasswordSecret": "UpstreamPassword"
      },
      "Microsoft365": {
        "TenantId": "",
        "ClientId": "",
        "Credential": "ClientSecret",
        "ClientSecretName": "M365ClientSecret",
        "CertificateThumbprint": "",
        "SenderUsername": "",
        "Scope": "https://outlook.office365.com/.default"
      },
      "AzureCommunication": {
        "TenantId": "",
        "ClientId": "",
        "Credential": "ClientSecret",
        "ClientSecretName": "AcsClientSecret",
        "CertificateThumbprint": "",
        "SmtpUsername": "",
        "Scope": "https://communication.azure.com/.default"
      }
    },

    "Logging": {
      "Directory": "",
      "RetainedFileCountLimit": 31,
      "RetainedFileTimeLimitDays": 31,
      "FileSizeLimitBytes": 52428800,
      "MinimumLevel": "Information",
      "Console": true,
      "AuditTrail": true,
      "EventLog": true
    },

    "Delivery": {
      "SpoolFailedMessages": true,
      "FailedSpoolDirectory": "",
      "FailedSpoolRetentionDays": 30
    },

    "Updates": {
      "CheckOnStartup": true
    },

    "Snmp": {
      "Enabled": false,
      "IpAddress": "0.0.0.0",
      "Port": 1161,
      "CommunitySecret": "SnmpCommunity",
      "AllowedManagers": []
    }
  }
}
