<Window x:Class="SmtpRelay.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmtpRelay.Manager"
        xmlns:vm="clr-namespace:SmtpRelay.Manager.ViewModels"
        Title="NEXQ SMTP Relay" Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <local:EqualsToVisibilityConverter x:Key="PageVis" />
        <local:EqualsConverter x:Key="Eq" />
        <local:BoolToVisibilityConverter x:Key="Vis" />
        <local:KindToBrushConverter x:Key="Kind" />
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Background="{StaticResource Navy}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,26">
                    <Image Source="/Assets/mark.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMTP Relay" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="by NEXQ" Foreground="{StaticResource NavMuted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,16,18">
                    <Border Background="{StaticResource NavyLight}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}" Cursor="Hand" MouseLeftButtonUp="UpdateBadge_Click">
                        <StackPanel>
                            <TextBlock Text="Update available" Foreground="White" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding LatestRelease.Tag}" Foreground="#93C5FD" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource NavMuted}" FontSize="11.5" />
                    <TextBlock Text="© NEXQ S.r.l." Foreground="{StaticResource NavMuted}" FontSize="11.5" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE80F;" Content="Overview"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Overview}" />
                    <TextBlock Text="CONFIGURATION" Foreground="{StaticResource NavMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="24,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE774;" Content="Listener"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Listener}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xEA18;" Content="Allowed senders"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Access}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE724;" Content="Smart host"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=SmartHost}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE72E;" Content="Inbound TLS"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Tls}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;" Content="Logging &amp; retention"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Logging}" />
                    <TextBlock Text="MONITORING" Foreground="{StaticResource NavMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="24,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8A5;" Content="Logs"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Logs}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7BA;" Content="Undelivered"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Undelivered}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE9D9;" Content="SNMP"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Snmp}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE946;" Content="About &amp; updates"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=About}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="32,24,32,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Margin="0,0,10,0" Cursor="Hand" Click="ReadOnlyTag_Click" FocusVisualStyle="{x:Null}"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource Vis}}"
                        ToolTip="Click to see who is changing the settings and to ask them to close their console.">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="15" Height="30" Padding="12,0,14,0" Background="{StaticResource WarnSoft}" BorderThickness="1" BorderBrush="{StaticResource Warn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ReadOnlyText}" Foreground="#92400E" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="15" Height="30" Padding="12,0,14,0"
                        Background="{Binding ServiceStateKind, Converter={StaticResource Kind}, ConverterParameter=soft}"
                        BorderThickness="1" BorderBrush="{StaticResource Line}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding ServiceStateKind, Converter={StaticResource Kind}}" Margin="0,0,8,0" />
                        <TextBlock Text="Service: " Foreground="{StaticResource TextSoft}" FontSize="12.5" />
                        <TextBlock Text="{Binding ServiceStateText}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pages -->
            <Grid Grid.Row="1">

                <!-- ============ Overview ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Overview}">
                    <StackPanel Margin="32,0,32,16">

                        <Border Style="{StaticResource CardBorder}" Background="{StaticResource PrimarySoft}" BorderBrush="#BFDBFE"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Primary}" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="The setup is downloaded from GitHub, verified (SHA-256 and NEXQ signature) and installed. Your settings are kept."
                                               Style="{StaticResource Sub}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="See the update" Style="{StaticResource PrimaryButton}" Click="UpdateBadge_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Margin="0" Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WINDOWS SERVICE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="10" Height="10" Fill="{Binding ServiceStateKind, Converter={StaticResource Kind}}" Margin="0,2,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ServiceStateText}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ServiceDetail}" Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="&#xE768;" Style="{StaticResource IconButton}" Width="38" Height="34" BorderBrush="{StaticResource Primary}" Foreground="{StaticResource Primary}"
                                                ToolTip="Start the service" Click="Start_Click" IsEnabled="{Binding CanEdit}"
                                                Visibility="{Binding IsServiceStopped, Converter={StaticResource Vis}}" />
                                        <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Width="38" Height="34" BorderBrush="{StaticResource LineStrong}" Margin="0,0,8,0"
                                                ToolTip="Restart the service" Click="Restart_Click" IsEnabled="{Binding CanEdit}"
                                                Visibility="{Binding IsServiceRunning, Converter={StaticResource Vis}}" />
                                        <Button Content="&#xE71A;" Style="{StaticResource IconButton}" Width="38" Height="34" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Danger}"
                                                ToolTip="Stop the service" Click="Stop_Click" IsEnabled="{Binding CanEdit}"
                                                Visibility="{Binding IsServiceRunning, Converter={StaticResource Vis}}" />
                                        <Button Content="Install the service" Style="{StaticResource PrimaryButton}" Click="Install_Click" IsEnabled="{Binding CanEdit}"
                                                Visibility="{Binding IsServiceInstalled, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0" Padding="18,12">
                                <StackPanel>
                                    <TextBlock Text="DELIVERED TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding DeliveredToday}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ok}" Margin="0,1,0,0" />
                                    <TextBlock Text="forwarded to the smart host" Style="{StaticResource Sub}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="0" Padding="18,12">
                                <StackPanel>
                                    <TextBlock Text="FAILED TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding FailedToday}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Danger}" Margin="0,1,0,0" />
                                    <TextBlock Text="refused or not delivered" Style="{StaticResource Sub}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Messages" Style="{StaticResource H2}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Rectangle Width="14" Height="3" Fill="{StaticResource Ok}" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5" />
                                            <TextBlock Margin="6,0,18,0" FontSize="12.5" Foreground="{StaticResource TextSoft}">
                                                <Run Text="Delivered " /><Run Text="{Binding ChartDeliveredTotal, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Rectangle Width="14" Height="3" Fill="{StaticResource Danger}" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5" />
                                            <TextBlock Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource TextSoft}">
                                                <Run Text="Failed " /><Run Text="{Binding ChartFailedTotal, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="170" VerticalAlignment="Top" ItemsSource="{Binding ChartPeriods}"
                                              SelectedItem="{Binding SelectedChartPeriod}" />
                                </Grid>
                                <local:TrendChart Height="190" Margin="0,10,0,0" Delivered="{Binding ChartDelivered}" Failed="{Binding ChartFailed}" Labels="{Binding ChartLabels}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding ChartNote}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Configuration" Style="{StaticResource H2}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Listening on" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ListenerSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="Forwarding to" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpstreamSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Allowed senders" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="Inbound TLS" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TlsMode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Text="Settings file" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfigPath}" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="8"
                                        Background="{Binding HealthKind, Converter={StaticResource Kind}, ConverterParameter=soft}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HealthText}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                        <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,2">
                                                        <Run Text="&#x2022; " /><Run Text="{Binding Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Foreground="#92400E" Margin="0,2">
                                                        <Run Text="&#x2022; " /><Run Text="{Binding Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasRecentFailures, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Latest failures today" Style="{StaticResource H2}" />
                                    <Button Content="Open the logs" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="OpenLogsPage_Click" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RecentFailures}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource TextSoft}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Listener ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Listener}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Network" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Text="Point your printers, applications and devices to this computer and port." Margin="0,0,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Listen on IP address" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="0.0.0.0 = every IPv4 address of this computer." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.Port, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="25 is the standard SMTP port. 587 is common for devices." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Server name" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.ServerName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Shown to clients in the SMTP greeting." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Limits" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Text="Protect the relay and the smart host from oversized or abusive traffic." Margin="0,0,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max message size (MB)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding MaxMessageSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max recipients per message" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.MaxRecipients, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Max concurrent sessions" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.MaxConcurrentSessions, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Command timeout (seconds)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Listener.CommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="Microsoft 365 accepts messages up to 25 MB by default (attachments grow by about a third when encoded)." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Allowed senders ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Access}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="IP allowlist" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16"
                                           Text="Connections from any other address are closed before the SMTP greeting: the relay does not even reveal that it is a mail server. Use single addresses (192.168.10.25) or networks in CIDR notation (192.168.10.0/24, 2001:db8::/32)." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewIpBox" KeyDown="NewIpBox_KeyDown" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Add" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddIp_Click" />
                                        <Button Content="Import from IIS 6…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ImportIis_Click"
                                                ToolTip="Copies the computers of the Relay restrictions of the IIS 6 SMTP service installed on this computer." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NewIpError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />

                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,14,0,0" MinHeight="60">
                                    <Grid>
                                        <TextBlock Text="The list is empty." Foreground="{StaticResource TextMuted}" Margin="14,48,14,14" x:Name="EmptyIpText" />
                                        <StackPanel>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0" Background="{StaticResource Page}" CornerRadius="8,8,0,0">
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="ADDRESS OR NETWORK" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="DNS NAME" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="LAST USED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="MESSAGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding AllowedIpRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                                                            <Grid Height="40">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="170" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="128" />
                                                                    <ColumnDefinition Width="128" />
                                                                    <ColumnDefinition Width="70" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding StateIcon}" Style="{StaticResource Icon}" ToolTip="{Binding StateTip}"
                                                                           Foreground="{Binding StateKind, Converter={StaticResource Kind}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Entry}" FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center"
                                                                           Opacity="{Binding TextOpacity}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding HostName}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                           Foreground="{StaticResource TextSoft}" Opacity="{Binding TextOpacity}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostName}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding LastUsed}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" Opacity="{Binding TextOpacity}" />
                                                                <TextBlock Grid.Column="4" Text="{Binding Messages}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" Opacity="{Binding TextOpacity}" />
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Button Content="{Binding ToggleIcon}" ToolTip="{Binding ToggleTip}" Style="{StaticResource IconButton}"
                                                                            Click="ToggleIp_Click" Tag="{Binding}" />
                                                                    <Button Content="&#xE74D;" ToolTip="Remove from the list" Style="{StaticResource IconButton}" Foreground="{StaticResource Danger}"
                                                                            Click="RemoveIp_Click" Tag="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding SenderActivityNote}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Sign-in with user name and password" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                           Text="Devices and applications can sign in to the relay with SMTP authentication (AUTH PLAIN or LOGIN). The users are created here and belong to the relay only: they are not Windows accounts, and they are not the account the relay uses on the smart host." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Style="{StaticResource Choice}" GroupName="SignIn" IsChecked="{Binding IsSignInOff}">
                                        <StackPanel>
                                            <TextBlock Text="Off" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Nobody signs in: the IP allowlist alone decides who may send." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="2" Style="{StaticResource Choice}" GroupName="SignIn" IsChecked="{Binding IsSignInOptional}">
                                        <StackPanel>
                                            <TextBlock Text="Optional" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Clients may sign in. Addresses of the allowlist can still send without a password." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="4" Style="{StaticResource Choice}" GroupName="SignIn" IsChecked="{Binding IsSignInRequired}">
                                        <StackPanel>
                                            <TextBlock Text="Required" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Every client must sign in before it can send, also from the allowlist." />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <StackPanel Visibility="{Binding SignInEnabled, Converter={StaticResource Vis}}">
                                    <CheckBox Style="{StaticResource Switch}" Margin="0,18,0,0"
                                              IsChecked="{Binding Options.Security.Authentication.AllowFromAnyAddress}" Content="Users who sign in can connect from any address" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="50,6,0,0"
                                               Text="Off: the allowlist applies to everyone, signed in or not. On: computers outside the allowlist can connect, and can send only after signing in; the relay then answers anyone who reaches its port." />
                                    <CheckBox Style="{StaticResource Switch}" Margin="0,14,0,0"
                                              IsChecked="{Binding Options.Security.Authentication.AllowWithoutTls}" Content="Accept passwords on connections that are not encrypted" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="50,6,0,0" Text="{Binding SignInTlsNote}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                               Text="These three settings need a restart of the service. After ten wrong passwords in ten minutes an address is refused for the rest of that time." />
                                </StackPanel>

                                <TextBlock Text="Users" Style="{StaticResource Label}" Margin="0,20,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox x:Name="NewUserBox" KeyDown="NewUser_KeyDown" />
                                        <TextBlock Style="{StaticResource Hint}" Text="User name, for example scanner or erp@contoso.com." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <PasswordBox x:Name="NewUserPasswordBox" KeyDown="NewUser_KeyDown" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Password, at least 8 characters." />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Add user" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Top" Click="AddUser_Click" />
                                </Grid>
                                <TextBlock x:Name="NewUserError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,14,0,0" MinHeight="48">
                                    <Grid>
                                        <TextBlock Text="No user yet." Foreground="{StaticResource TextMuted}" Margin="14" x:Name="EmptyUserText" />
                                        <ItemsControl ItemsSource="{Binding Users}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                                                        <Grid Height="40">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Margin="0,0,12,0"
                                                                       Foreground="{Binding StateKind, Converter={StaticResource Kind}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"
                                                                       Foreground="{Binding StateKind, Converter={StaticResource Kind}}" />
                                                            <Button Grid.Column="3" Content="Change password" Style="{StaticResource LinkButton}"
                                                                    VerticalAlignment="Center" Margin="0,0,16,0" Click="ChangeUserPassword_Click" Tag="{Binding Name}" />
                                                            <Button Grid.Column="4" Content="{Binding ToggleText}" Style="{StaticResource LinkButton}"
                                                                    VerticalAlignment="Center" Margin="0,0,16,0" Click="ToggleUser_Click" Tag="{Binding}" />
                                                            <Button Grid.Column="5" Content="Remove" Style="{StaticResource LinkButton}" Foreground="{StaticResource Danger}"
                                                                    VerticalAlignment="Center" Click="RemoveUser_Click" Tag="{Binding Name}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Users are saved at once and reach the running service without a restart. Only a salted hash of each password is kept: a forgotten password cannot be read back, only changed." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="When the list is empty" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0"
                                          IsChecked="{Binding Options.Security.RejectWhenAllowListEmpty}" Content="Refuse every connection (recommended)" />
                                <TextBlock Style="{StaticResource Hint}" Margin="50,6,0,0"
                                           Text="When this is off and the list is empty, anyone who can reach the port can send mail through your account (open relay)." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Smart host ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=SmartHost}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="How the relay signs in" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <RadioButton Style="{StaticResource Choice}" GroupName="Mode" IsChecked="{Binding IsMicrosoft365}">
                                        <StackPanel>
                                            <TextBlock Text="Microsoft 365" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Modern authentication (OAuth2) with an app registration. No mailbox password." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="2" Style="{StaticResource Choice}" GroupName="Mode" IsChecked="{Binding IsAzureCommunication}">
                                        <StackPanel>
                                            <TextBlock Text="Azure Communication Services" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Azure's e-mail service, with an app registration (OAuth2). No mailbox needed." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Row="2" Style="{StaticResource Choice}" GroupName="Mode" IsChecked="{Binding IsBasic}">
                                        <StackPanel>
                                            <TextBlock Text="User name and password" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="Any SMTP server or provider that accepts SMTP AUTH." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Row="2" Grid.Column="2" Style="{StaticResource Choice}" GroupName="Mode" IsChecked="{Binding IsAnonymous}">
                                        <StackPanel>
                                            <TextBlock Text="No authentication" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="A server that trusts this computer's IP, such as an Exchange connector." />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Microsoft Entra application: Microsoft 365 and Azure Communication Services -->
                        <Border Style="{StaticResource CardBorder}" Visibility="{Binding UsesEntraApp, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding EntraCardTitle}" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16" Text="{Binding EntraCardIntro}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tenant ID or domain" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding EntraApp.TenantId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Application (client) ID" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding EntraApp.ClientId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding EntraIdentityLabel}" Style="{StaticResource Label}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding EntraIdentity, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding EntraIdentityHint}" />

                                <TextBlock Text="The application proves its identity with" Style="{StaticResource Label}" Margin="0,20,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Style="{StaticResource Choice}" GroupName="Credential" IsChecked="{Binding UsesClientSecret}">
                                        <StackPanel>
                                            <TextBlock Text="A client secret" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="A password generated by Microsoft Entra ID. It expires and must be replaced here when it does." />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="2" Style="{StaticResource Choice}" GroupName="Credential" IsChecked="{Binding UsesCertificate}">
                                        <StackPanel>
                                            <TextBlock Text="A certificate" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="The private key never leaves this computer; only the public part is uploaded to the app registration." />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding UsesClientSecret, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <TextBlock Text="Client secret" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding ClientSecretStatus}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ClientSecretBox" />
                                        <Button Grid.Column="1" Content="Store" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="StoreClientSecret_Click" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="Encrypted with Windows DPAPI on this computer. It is never written to the settings file and never shown again." />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding UsesCertificate, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <TextBlock Text="Certificate from the computer store" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding EntraCertificateStatus}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding Certificates}" DisplayMemberPath="Display" SelectedValuePath="Thumbprint"
                                              SelectedValue="{Binding EntraCertificateThumbprint}" />
                                    <TextBlock Text="Thumbprint" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                    <TextBox Text="{Binding EntraCertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Create a certificate…" Style="{StaticResource SecondaryButton}" Click="CreateCertificate_Click" Margin="0,0,8,0" />
                                        <Button Content="Export the public certificate (.cer)…" Style="{StaticResource SecondaryButton}" Click="ExportCertificate_Click" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="The certificate must be in Local Machine &gt; Personal with its private key, and its public part (.cer) must be uploaded to the app registration under Certificates &amp; secrets. When the service runs as a dedicated account, give that account read access to the private key." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Basic -->
                        <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsBasic, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="Credentials" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="User name" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.Basic.Username, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="Password" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding PasswordStatus}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="PasswordBoxBasic" />
                                            <Button Grid.Column="1" Content="Store" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="StorePassword_Click" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Encrypted with Windows DPAPI on this computer. It is never written to the settings file." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Server" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Host" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.Host, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Connection security" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.SecureModes}" SelectedItem="{Binding Options.Upstream.Security}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="StartTls and SslOnConnect always encrypt. None and StartTlsWhenAvailable may send credentials in clear text and are refused unless you allow it below." />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding Options.Upstream.AllowInsecureAuthentication}"
                                          Content="Allow sending credentials over an unencrypted connection (not recommended)"
                                          Visibility="{Binding IsAnonymous, Converter={StaticResource Vis}, ConverterParameter=invert}" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Always send as (optional)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.OverrideFromAddress, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Attempts" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.MaxAttempts, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Retry delay (s)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.RetryBaseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Timeout (s)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Upstream.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="&quot;Always send as&quot; replaces the envelope sender of every message. Use it when the smart host only accepts mail from one address." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Test" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Text="Uses the settings on this page, even before you save them. Store the secret first." Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TestButton" Content="Test connection" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click" Margin="0,0,8,0" />
                                    <Button x:Name="TestMailButton" Content="Send a test message…" Style="{StaticResource SecondaryButton}" Click="SendTest_Click" />
                                </StackPanel>
                                <Border x:Name="TestResult" Visibility="Collapsed" Margin="0,14,0,0" Padding="14,10" CornerRadius="8">
                                    <TextBlock x:Name="TestResultText" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Inbound TLS ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Tls}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Encryption for clients" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16"
                                           Text="The connection from the relay to the smart host is encrypted separately (Smart host page). This page is about the first hop: device to relay." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STARTTLS" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.TlsModes}" SelectedItem="{Binding TlsMode}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="None: clear text. StartTlsOptional: offered. StartTlsRequired: mail is refused until the client encrypts the session." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Minimum protocol" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.TlsProtocols}" SelectedItem="{Binding Options.Tls.MinimumProtocol}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="TLS 1.0 and 1.1 are never accepted." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Visibility="{Binding TlsEnabled, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="Certificate" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16"
                                           Text="Choose a certificate installed in the computer store (Local Machine &gt; Personal), or a .pfx file. The store is recommended: the private key stays protected by Windows." />
                                <TextBlock Text="Certificate from the computer store" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding Certificates}" DisplayMemberPath="Display" SelectedValuePath="Thumbprint"
                                          SelectedValue="{Binding Options.Tls.CertificateThumbprint}" />
                                <TextBlock Text="Thumbprint" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding Options.Tls.CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" />

                                <TextBlock Text="Or a .pfx file" Style="{StaticResource Label}" Margin="0,20,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PfxPathBox" Text="{Binding Options.Tls.CertificatePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowsePfx_Click" />
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Password of the .pfx file" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding PfxPasswordStatus}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PfxPasswordBox" />
                                    <Button Grid.Column="1" Content="Store" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="StorePfxPassword_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Logging ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Logging}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="What is recorded" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Detail level" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:MainViewModel.LogLevels}" SelectedItem="{Binding Options.Logging.MinimumLevel}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Information is right for production. Debug also records every connection." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Log folder (empty = default)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Logging.Directory, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Options.LogDirectory, StringFormat='Currently: {0}'}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Style="{StaticResource Switch}" Margin="0,18,0,0" IsChecked="{Binding Options.Logging.AuditTrail}"
                                          Content="Delivery audit trail: one line per message (who, from, to, size, subject, outcome) in audit-*.log" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding Options.Logging.EventLog}"
                                          Content="Write warnings and errors to the Windows Application event log (source SmtpRelay)" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Retention" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Text="A new file starts every day and whenever the size limit is reached. Older files are deleted automatically." Margin="0,0,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Keep for (days)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Empty = no time limit. The chart of the Overview page and the figures of Allowed senders cover these days." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max files of each kind" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Logging.RetainedFileCountLimit, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Max file size (MB)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding LogFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Undelivered messages" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" Margin="0,10,0,0" IsChecked="{Binding Options.Delivery.SpoolFailedMessages}"
                                          Content="Keep a copy (.eml) of every message that could not be delivered" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Delete copies after (days)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Delivery.FailedSpoolRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="0 = keep forever." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Folder (empty = default)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Delivery.FailedSpoolDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Options.FailedSpoolDirectory, StringFormat='Currently: {0}'}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Logs ============ -->
                <Grid Margin="32,0,32,16" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Logs}">
                    <Border Style="{StaticResource CardBorder}" Margin="0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding LogFiles}" SelectedItem="{Binding SelectedLogFile}" />
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="LogFilterBox" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                    <TextBlock Text="Filter: address, subject, FAILED…" Foreground="{StaticResource Off}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding IsLogFilterEmpty, Converter={StaticResource Vis}}" />
                                </Grid>
                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" Content="Live" IsChecked="{Binding AutoRefreshLogs}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <Button Grid.Column="4" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshLogs_Click" Margin="16,0,0,0" />
                                <Button Grid.Column="5" Content="Open folder" Style="{StaticResource SecondaryButton}" Click="OpenLogFolder_Click" Margin="8,0,0,0" />
                            </Grid>
                            <Border Grid.Row="1" Background="#0B1220" CornerRadius="0,0,9,9">
                                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#D1D9E6" Background="Transparent" BorderThickness="0"
                                         Height="NaN" Padding="14,10" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ SNMP ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Undelivered}">
                    <StackPanel Margin="32,0,32,16">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Messages that were not delivered" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                           Text="The relay has no queue of its own. When the smart host cannot take a message, the device that sent it receives a temporary error and is expected to try again by itself; when the smart host refuses a message, the device is told so. In both cases a copy is kept here. A copy disappears when the same message is delivered later, when you send it again or delete it, and when it is older than the retention set in Logging &amp; retention." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding UndeliveredSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshUndelivered_Click" Margin="0,0,8,0" />
                                        <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Click="OpenSpoolFolder_Click" Margin="0,0,8,0" />
                                        <Button Content="Resend all" Style="{StaticResource PrimaryButton}" Click="ResendAll_Click" IsEnabled="{Binding CanResendAll}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Undelivered}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                    Background="{Binding KindState, Converter={StaticResource Kind}, ConverterParameter=soft}">
                                                                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding KindState, Converter={StaticResource Kind}}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                        </StackPanel>
                                                        <TextBlock Margin="0,5,0,0" FontSize="12.5" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding From, Mode=OneWay}" FontFamily="{StaticResource Mono}" /><Run Text="  →  " /><Run Text="{Binding To, Mode=OneWay}" FontFamily="{StaticResource Mono}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextMuted}">
                                                            <Run Text="{Binding Time, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Client, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Text="{Binding Reason}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                                        <Button Content="Resend" Style="{StaticResource LinkButton}" Margin="0,0,16,0" Click="ResendOne_Click" Tag="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="Open" Style="{StaticResource LinkButton}" Margin="0,0,16,0" Click="OpenUndelivered_Click" Tag="{Binding}" />
                                                        <Button Content="Delete" Style="{StaticResource LinkButton}" Foreground="{StaticResource Danger}" Click="DeleteUndelivered_Click" Tag="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Resend goes straight to the smart host with the settings of this console and the original sender and recipients. If the device has sent the same message again in the meantime, the recipient receives it twice: resend what the device will not retry. What you resend or delete is written to the console log, not to the audit trail." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Snmp}">
                    <StackPanel Margin="32,0,32,16" IsEnabled="{Binding CanEdit}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="SNMP agent" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                           Text="The relay answers read-only SNMP v1 and v2c requests itself. It does not replace or change the Windows SNMP service: that keeps UDP port 161, and this agent listens on the port below. Point your monitoring system to this computer and this port." />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SnmpEnabled}" Content="Answer SNMP requests" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Listen on address" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Snmp.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="0.0.0.0 listens on every network interface. An IP address or a DNS name of this computer listens on that one only." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="UDP port" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Options.Snmp.Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <Grid>
                                            <TextBlock Text="Community" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding SnmpCommunityStatus}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="CommunityBox" />
                                            <Button Grid.Column="1" Content="Store" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="StoreCommunity_Click" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="The password of SNMP v2c. Kept encrypted; takes effect at once." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="Turning the agent on or off, and changing the address or the port, needs a restart of the service. If you chose the Windows Firewall option in the setup, the monitoring system can already reach the relay program." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Monitoring systems allowed to ask" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,16"
                                           Text="Requests from any other address are ignored without an answer. Use single addresses, networks in CIDR notation or DNS names (nms01.contoso.local). Names are turned into addresses when the service starts and every five minutes. While the list is empty nobody is answered." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewManagerBox" KeyDown="NewManagerBox_KeyDown" />
                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddManager_Click" />
                                </Grid>
                                <TextBlock x:Name="NewManagerError" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,14,0,0" MinHeight="48">
                                    <Grid>
                                        <TextBlock Text="The list is empty." Foreground="{StaticResource TextMuted}" Margin="14" x:Name="EmptyManagerText" />
                                        <ItemsControl ItemsSource="{Binding SnmpManagers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                                                        <Grid Height="40">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource Ok}" Margin="0,0,12,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource LinkButton}" Foreground="{StaticResource Danger}"
                                                                    VerticalAlignment="Center" Click="RemoveManager_Click" Tag="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="What to read" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,14"
                                           Text="Both values are the same figures shown on the Overview page. They count messages, not recipients, and go back to zero at midnight (local time)." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Delivered today (Gauge32)" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding SnmpDeliveredOid, Mode=OneWay}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="Copy" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="CopyOid_Click" Tag="{Binding SnmpDeliveredOid, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Text="Failed today (Gauge32)" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SnmpFailedOid, Mode=OneWay}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Copy" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="CopyOid_Click" Tag="{Binding SnmpFailedOid, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="Example with Net-SNMP" Style="{StaticResource Label}" Margin="0,16,0,6" />
                                <TextBox Text="{Binding SnmpExample, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Save the MIB file…" Style="{StaticResource SecondaryButton}" Click="SaveMib_Click" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Import the MIB file (NEXQ-SMTP-RELAY-MIB) into your monitoring system to see the names instead of the numbers. The agent also answers sysDescr, sysObjectID, sysUpTime and sysName, so it can be added as a device." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ About ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=About}">
                    <StackPanel Margin="32,0,32,16">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Sub}" Margin="0,2,0,14" />

                                <Border Background="{StaticResource PrimarySoft}" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                                        Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" FontSize="12.5" />
                                        </ScrollViewer>
                                        <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}"
                                                     Visibility="{Binding IsInstallingUpdate, Converter={StaticResource Vis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Download and install" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,8,0" />
                                            <Button Content="Release notes on GitHub" Style="{StaticResource SecondaryButton}" Click="OpenReleasePage_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding CheckUpdatesOnStartup}"
                                          Content="Check for updates when this console is opened" />
                                <TextBlock Style="{StaticResource Hint}" Margin="50,6,0,0"
                                           Text="Only the console contacts GitHub (api.github.com), and only to read the latest release: nothing about this computer is sent. The service itself never goes online for updates. An update is installed only if it is signed by NEXQ S.r.l." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Backup and restore" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,14"
                                           Text="Saves the settings, the stored secrets (passwords, client secret, SNMP community) and the users of the relay in one file protected by a password, to move the relay to another server or to keep a copy. Certificates, logs and undelivered messages are not included." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Back up settings…" Style="{StaticResource PrimaryButton}" Click="Backup_Click" Margin="0,0,8,0" />
                                    <Button Content="Restore from a backup…" Style="{StaticResource SecondaryButton}" Click="Restore_Click" IsEnabled="{Binding CanEdit}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="On the new server: install SMTP Relay, open this page, restore the backup, then import the certificates if you use them and restart the service. Restore replaces every setting, secret and user of this installation." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/mark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="NEXQ SMTP Relay" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sub}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,14,0,0"
                                           Text="A modern replacement for the Windows SMTP relay: it accepts mail from the devices and applications you allow, and forwards it to Microsoft 365 or to any SMTP server." />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0"
                                           Text="Copyright © NEXQ S.r.l. Released under the PolyForm Shield License 1.0.0: free for personal and business use; it cannot be resold or offered as a competing product. Third-party components keep their own licenses (see NOTICE)." />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Project on GitHub" Style="{StaticResource SecondaryButton}" Click="OpenRepository_Click" Margin="0,0,8,0" />
                                    <Button Content="www.nexq.it" Style="{StaticResource SecondaryButton}" Click="OpenWebsite_Click" Margin="0,0,8,0" />
                                    <Button Content="License" Style="{StaticResource SecondaryButton}" Click="OpenLicense_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding FooterKind, Converter={StaticResource Kind}}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding FooterText}" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding FooterText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Discard changes" Style="{StaticResource SecondaryButton}" Click="Discard_Click" IsEnabled="{Binding IsDirty}" Margin="0,0,8,0" />
                        <Button Content="Save" Style="{StaticResource SecondaryButton}" Click="Save_Click" IsEnabled="{Binding CanSave}" Margin="0,0,8,0" />
                        <Button Content="Save and restart service" Style="{StaticResource PrimaryButton}" Click="SaveRestart_Click" IsEnabled="{Binding CanSave}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Busy overlay -->
            <Border x:Name="Busy" Grid.RowSpan="3" Background="#99F1F5F9" Visibility="Collapsed">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="26,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="90" Height="6" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock x:Name="BusyText" Text="Working…" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
